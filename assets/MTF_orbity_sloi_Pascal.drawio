        <mxCell id="339" parent="1" style="html=1;whiteSpace=wrap;overflow=hidden;verticalAlign=middle;fillColor=none;strokeColor=none;fontSize=11;fontColor=#203047;align=center;fontStyle=0;spacing=2;" value="z = 3" vertex="1">
          <mxGeometry height="17" width="360" x="3165" y="2282" as="geometry" />
        </mxCell>
        <mxCell id="340" parent="1" style="html=1;whiteSpace=wrap;overflow=hidden;verticalAlign=middle;rounded=1;arcSize=6;fillColor=#F2F7FC;strokeColor=#BCD2E7;fontColor=#17304B;fontSize=18;align=left;verticalAlign=top;spacingLeft=16;spacingTop=12;" value="&lt;b&gt;3⁵ − 3 = 240 = 5 × 48&lt;/b&gt;&lt;br&gt;3 прозрачных диагональных клеток; 48 полных циклов по 5." vertex="1">
          <mxGeometry height="100" width="3440" x="85" y="2348" as="geometry" />
        </mxCell>
        <mxCell id="341" parent="1" style="html=1;whiteSpace=wrap;overflow=hidden;verticalAlign=middle;rounded=1;arcSize=6;fillColor=#F2F7FC;strokeColor=#BCD2E7;fontColor=#17304B;fontSize=19;align=left;verticalAlign=top;spacingLeft=16;spacingTop=12;" value="&lt;b&gt;Шаг индукции:&lt;/b&gt; (a + 1)⁵ − (a + 1) = (a⁵ − a) + 5a⁴ + 10a³ + 10a² + 5a.&lt;br&gt;Каждый внутренний коэффициент делится на 5; поэтому шаг сохраняет делимость. Циклический сдвиг пяти координат даёт группы по 5 для каждой недиагональной точки." vertex="1">
          <mxGeometry height="135" width="3460" x="85" y="2580" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
