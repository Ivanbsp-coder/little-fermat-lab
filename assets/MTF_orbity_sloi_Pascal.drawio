        <mxCell id="121" parent="1" style="html=1;whiteSpace=wrap;overflow=hidden;verticalAlign=middle;rounded=1;arcSize=8;fillColor=#A7EAD8;fillOpacity=66;strokeColor=#48A89B;fontSize=17;fontColor=#1A3445;fontStyle=1;align=center;" value="13" vertex="1">
