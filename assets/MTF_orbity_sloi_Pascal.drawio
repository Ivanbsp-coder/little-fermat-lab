    <mxGraphModel dx="1842" dy="1155" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1560" pageHeight="1630" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" parent="1" style="html=1;whiteSpace=wrap;overflow=hidden;verticalAlign=middle;rounded=1;arcSize=9;fillColor=#17304B;strokeColor=#17304B;fontColor=#FFFFFF;fontSize=27;fontStyle=1;align=left;spacingLeft=22;" value="Лист_2 — r = 3: куб из сдвинутых срезов" vertex="1">
          <mxGeometry height="56" width="1500" x="30" y="26" as="geometry" />
        </mxCell>
        <mxCell id="3" parent="1" style="html=1;whiteSpace=wrap;overflow=hidden;verticalAlign=middle;fillColor=none;strokeColor=none;fontSize=15;fontColor=#31435D;align=left;fontStyle=0;spacing=2;" value="Каждая плоскость — квадрат a × a; слои z сдвинуты вправо и вверх. В каждой клетке записан полный адрес x, y, z." vertex="1">
