        <mxCell id="158" parent="1" style="html=1;whiteSpace=wrap;overflow=hidden;verticalAlign=middle;rounded=0;fillColor=#E85683;fillOpacity=53;strokeColor=#65758C;strokeWidth=1.1;fontColor=#132238;fontSize=15;fontStyle=1;align=center;" tooltip="(3, 1, 3, 3); длина цикла 4" value="3, 1, 3, 3" vertex="1">
